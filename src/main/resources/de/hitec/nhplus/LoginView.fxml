<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/10.0.2-internal"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="de.hitec.nhplus.controller.LoginController"
      alignment="CENTER"
      spacing="15.0"
      prefHeight="300.0"
      prefWidth="420.0"
      stylesheets="@Application.css">

    <padding>
        <Insets top="40.0" right="60.0" bottom="40.0" left="60.0"/>
    </padding>

    <children>

        <!-- Titel -->
        <Label text="NHPlus — Anmeldung">
            <font>
                <Font size="22.0"/>
            </font>
        </Label>

        <!-- Benutzername -->
        <TextField fx:id="textFieldUsername"
                   promptText="Benutzername"/>

        <!-- Passwort -->
        <PasswordField fx:id="passwordField"
                       promptText="Passwort"/>

        <!-- Login Button -->
        <Button fx:id="buttonLogin"
                text="Anmelden"
                defaultButton="true"
                maxWidth="Infinity"
                onAction="#handleLogin"/>

        <!-- Fehlermeldung -->
        <Label fx:id="labelError"
               text=""
               visible="false"
               wrapText="true"
               textFill="#c0392b"/>

    </children>
</VBox>