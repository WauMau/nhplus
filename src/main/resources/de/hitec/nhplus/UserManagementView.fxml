<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="de.hitec.nhplus.controller.UserManagementController">
    <children>
        <VBox spacing="10"
              AnchorPane.topAnchor="10"
              AnchorPane.leftAnchor="10"
              AnchorPane.rightAnchor="10"
              AnchorPane.bottomAnchor="10">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <HBox spacing="10">
                <Label text="Benutzername"/>
                <TextField fx:id="txtUsername"
                           promptText="Benutzername"
                           prefWidth="200"/>
                <Label text="Rolle"/>
                <ComboBox fx:id="cmbRole"
                          prefWidth="150"/>
                <Button text="Benutzer anlegen"
                        onAction="#handleCreateUser"/>
                <Button text="Aktivieren / Deaktivieren"
                        onAction="#handleToggleUser"/>
                <Button text="Einmal-Passwort erzeugen"
                        onAction="#handleGenerateOneTimePassword"/>
            </HBox>
            <TableView fx:id="tableUsers"
                       VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="columnUsername"
                                 text="Benutzername"
                                 prefWidth="300"/>
                    <TableColumn fx:id="columnRole"
                                 text="Rolle"
                                 prefWidth="200"/>
                    <TableColumn fx:id="columnActive"
                                 text="Aktiv"
                                 prefWidth="100"/>
                </columns>
            </TableView>
        </VBox>
    </children>
</AnchorPane>